---
import { credentialLabel } from '../lib/verdict';
import { formatDateLocale, localizedPath, type Locale } from '../i18n';
import type { CredentialStatus } from '../lib/schemas';
interface Credential { title: string; issuer: string; status: CredentialStatus; source?: string; checkedAt: Date; klaim?: string }
const { credentials, locale = 'id' } = Astro.props as { credentials: Credential[]; locale?: Locale };
const T = {
  id: { empty: 'Belum ada kredensial yang dicatat.', checked: 'Diperiksa', source: 'Sumber', klaim: 'Lihat cek klaim' },
  en: { empty: 'No credentials recorded yet.', checked: 'Checked', source: 'Source', klaim: 'See the claim check' },
}[locale];
---
{credentials.length === 0 ? (
  <p class="muted">{T.empty}</p>
) : (
  <ul class="stack">
    {credentials.map((c) => (
      <li>
        <strong>{c.title}</strong>, {c.issuer}
        <span class="badge badge--amber" data-credential={c.status}>{credentialLabel(c.status, locale)}</span>
        <span class="muted"> · {T.checked} {formatDateLocale(c.checkedAt, locale)}</span>
        {c.source && <> · <a href={c.source} rel="noopener noreferrer nofollow" target="_blank">{T.source}</a></>}
        {c.klaim && <> · <a href={localizedPath('claims', locale, c.klaim)}>{T.klaim} →</a></>}
      </li>
    ))}
  </ul>
)}
