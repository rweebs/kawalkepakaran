---
import '../styles/global.css';
import DisclaimerBanner from '../components/DisclaimerBanner.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LanguageToggle from '../components/LanguageToggle.astro';
import { SITE, isActive } from '../lib/site';
import { LOCALES, LANGUAGE_NAME, LANGUAGE_SHORT, OG_LOCALE, alternatesForPath, otherLocale, pathLocale, routePath, type Locale } from '../i18n';
import { UI, navFor } from '../i18n/ui';
import ThemeSong from '../components/ThemeSong.astro';
import { serializeJsonLd } from '../lib/jsonld';
import { correctionsFor } from '../lib/corrections';
import { formatDateLocale } from '../i18n';
import { buildTitle, truncateAtWord, breadcrumbLd } from '../lib/seo';
import { siteOg, type OgImage } from '../lib/og';

interface Crumb { name: string; path: string }
const { title, description, path, jsonLd, noindex, ogType = 'website', breadcrumbs, author, locale: localeProp, alternates: alternatesProp, image: imageProp, ogTitle, publishedTime, modifiedTime, section, feeds = [] } = Astro.props as {
  title: string; description: string; path: string; jsonLd?: object | object[]; noindex?: boolean;
  ogType?: 'website' | 'article'; breadcrumbs?: Crumb[]; author?: string;
  locale?: Locale; alternates?: Partial<Record<Locale, string>>;
  /** Social card; every page falls back to the site card in its own language. */
  image?: OgImage;
  /** Title for social previews only (verdict-first, no brand suffix); <title> stays tuned for search. */
  ogTitle?: string;
  /** ISO dates for article:published_time / article:modified_time. */
  publishedTime?: string; modifiedTime?: string; section?: string;
  /** Extra RSS feeds for this page (e.g. one expert's feed), linked after the site feed. */
  feeds?: { title: string; href: string }[];
};
const locale: Locale = localeProp ?? pathLocale(path);
const ui = UI[locale];
// Both language versions of this page, for hreflang and the language switch. Dynamic pages pass them in.
const alternates = alternatesProp ?? alternatesForPath(path);
const hreflangs = alternates && LOCALES.every((l) => alternates[l]) ? alternates : undefined;
const switchTo = otherLocale(locale);
const switchHref = alternates?.[switchTo] ?? routePath('home', switchTo);
const nav = navFor(locale);
const canonical = new URL(path, SITE.url).toString();
const image = imageProp ?? siteOg(locale);
const ogImage = new URL(image.src, SITE.url).toString();
const abs = (p: string) => new URL(p, SITE.url).toString();
const fullTitle = buildTitle(title, SITE.name);
const desc = truncateAtWord(description, 160);
const corrections = correctionsFor(path, undefined, Object.values(alternates ?? {}).filter((p): p is string => !!p));
const FOOT = { id: { log: 'Catatan koreksi', updates: 'Pembaruan' }, en: { log: 'Corrections log', updates: 'Updates' } }[locale];
const socialTitle = ogTitle ? truncateAtWord(ogTitle, 95) : fullTitle;
const feedHref = locale === 'en' ? '/en/rss.xml' : '/rss.xml';
const crumbs = breadcrumbs ? [{ name: ui.home, path: routePath('home', locale) }, ...breadcrumbs] : [];
const lds = [
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
  ...(crumbs.length > 1 ? [breadcrumbLd(crumbs.map((c) => ({ name: c.name, url: new URL(c.path, SITE.url).toString() })))] : []),
];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex
      ? <meta name="robots" content="noindex" />
      : <><meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" /><link rel="canonical" href={canonical} /></>}
    {hreflangs && !noindex && (
      <>
        {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={abs(hreflangs[l])} />)}
        <link rel="alternate" hreflang="x-default" href={abs(hreflangs.id)} />
      </>
    )}
    {SITE.googleVerification && <meta name="google-site-verification" content={SITE.googleVerification} />}
    {SITE.bingVerification && <meta name="msvalidate.01" content={SITE.bingVerification} />}
    <meta name="author" content={author ?? SITE.author} />
    <meta name="theme-color" content="#0a0e1a" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <noscript><link rel="stylesheet" href="/nojs.css" /></noscript>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={feedHref} />
    {feeds.map((f) => <link rel="alternate" type="application/rss+xml" title={f.title} href={f.href} />)}
    <link rel="alternate" type="application/json" title="Kawal Kepakaran claims" href="/klaim.json" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {hreflangs && !noindex && <meta property="og:locale:alternate" content={OG_LOCALE[switchTo]} />}
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={desc} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:type" content={image.type} />
    <meta property="og:image:alt" content={image.alt || ui.ogImageAlt} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && (modifiedTime ?? publishedTime) && <meta property="article:modified_time" content={modifiedTime ?? publishedTime} />}
    {ogType === 'article' && <meta property="article:author" content={author ?? SITE.author} />}
    {ogType === 'article' && section && <meta property="article:section" content={section} />}
    <meta name="twitter:card" content="summary_large_image" />
    {SITE.x && <meta name="twitter:site" content={SITE.x} />}
    {SITE.x && <meta name="twitter:creator" content={SITE.x} />}
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={image.alt || ui.ogImageAlt} />
    {lds.map((ld) => <script type="application/ld+json" set:html={serializeJsonLd(ld)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skipToContent}</a>
    <DisclaimerBanner locale={locale} />
    <header class="nav">
      <div class="container">
        <a href={routePath('home', locale)} class="brand"><img src="/logo-kawal.svg" alt="" width="32" height="32" />{SITE.name}</a>
        <div class="nav__lang-bar"><LanguageToggle locale={locale} href={switchHref} label={ui.language} /></div>
        <details class="nav__menu" open>
          <summary aria-label={ui.menu}><span class="nav__burger" aria-hidden="true"></span></summary>
          <ul class="nav__links">
            {nav.map((e) => 'items' in e ? (
              <li class="nav__group-item">
                <details class="nav__group">
                  <summary class:list={{ 'is-active': e.items.some((i) => isActive(path, i.href)) }}>{e.label}</summary>
                  <ul>{e.items.map((i) => <li><a href={i.href} data-astro-prefetch aria-current={isActive(path, i.href) ? 'page' : undefined}>{i.label}</a></li>)}</ul>
                </details>
              </li>
            ) : (
              <li><a href={e.href} data-astro-prefetch aria-current={isActive(path, e.href) ? 'page' : undefined}>{e.label}</a></li>
            ))}
            <li class="nav__lang"><LanguageToggle locale={locale} href={switchHref} label={ui.language} /></li>
          </ul>
        </details>
      </div>
    </header>
    {crumbs.length > 1 && <Breadcrumbs items={crumbs} locale={locale} />}
    <main id="main" tabindex="-1">
      {corrections.length > 0 && (
        <aside class="container notice" aria-label={ui.corrections}>
          {corrections.map((c) => <p><strong>{ui.correctedOn} {formatDateLocale(new Date(c.date), locale)}:</strong> {locale === 'en' ? c.en : c.id}</p>)}
        </aside>
      )}
      <slot />
    </main>
    <ThemeSong path={path} locale={locale} />
    <script>import '../scripts/nav-menu';</script>
    <script>if (document.querySelector('[data-reveal]')) import('../scripts/reveal');</script>
    <footer class="footer"><div class="container">
      <p>{ui.footer(SITE.author)} {ui.corrections}: <a href={`mailto:${SITE.correctionsEmail}`}>{SITE.correctionsEmail}</a>. {ui.projectOf} <a href="https://www.infraloka.co.id" rel="noopener noreferrer">InfraLoka</a>. <a href={routePath('policy', locale)}>{ui.policies}</a> · <a href={`${routePath('policy', locale)}#catatan-koreksi`}>{FOOT.log}</a> · <a href={routePath('updates', locale)}>{FOOT.updates}</a> · <a href={feedHref}>{ui.rss}</a> · <a href="/klaim.json">{ui.data}</a></p>
      <p class="muted">{ui.license} <a href={`${SITE.repo}/blob/main/LICENSE-CONTENT.md`} rel="noopener noreferrer">LICENSE-CONTENT</a></p>
    </div></footer>
  </body>
</html>
