---
import Page from '../../../arsip/artikel/[slug].astro';
import { getArsip } from '../../../../lib/arsip';

export async function getStaticPaths() {
  return (await getArsip()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<Page entry={entry} locale="en" />
