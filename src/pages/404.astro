---
import BaseLayout from '../layouts/BaseLayout.astro';
import { UI } from '../i18n/ui';
import { localizedPath, routePath, type Locale } from '../i18n';
const { locale = 'id' } = Astro.props as { locale?: Locale };
const t = UI[locale].notFound;
const links = [
  { href: routePath('experts', locale), label: locale === 'id' ? 'Pakar' : 'Experts' },
  { href: routePath('claims', locale), label: locale === 'id' ? 'Cek klaim' : 'Claim checks' },
  { href: routePath('method', locale), label: locale === 'id' ? 'Metode' : 'Method' },
];
---
<BaseLayout title={t.title} description={`${t.title}.`} path={locale === 'en' ? '/en/404' : '/404'} locale={locale} noindex>
  <section class="reading">
    <h1>{t.title}</h1>
    <p><a href={localizedPath('home', locale)}>{t.back}</a></p>
    <ul>{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
  </section>
</BaseLayout>
