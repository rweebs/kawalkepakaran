---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';
import { localizedPath, type Locale } from '../i18n';
const { locale = 'id' } = Astro.props as { locale?: Locale };
const path = localizedPath('reply', locale);
const T = {
  id: { title: 'Hak jawab Abil Sudarman', h1: 'Hak jawab', crumb: 'Hak jawab',
    description: 'Cara Abil Sudarman menanggapi isi situs ini: tanggapan dikirim lewat email dan dimuat apa adanya, tanpa penyuntingan, bersama tulisan yang bersangkutan.' },
  en: { title: 'Right of reply for Abil Sudarman', h1: 'Right of reply', crumb: 'Right of reply',
    description: 'How Abil Sudarman can respond to this site: replies are sent by email and published as received, without editing, alongside the piece concerned.' },
}[locale];
---
<BaseLayout title={T.title} description={T.description} path={path} locale={locale} breadcrumbs={[{ name: T.crumb, path }]}>
  <article class="reading">
    <h1>{T.h1}</h1>
    {locale === 'id' ? (
      <>
        <p>Abil Sudarman berhak menanggapi, mengoreksi, atau menambahkan konteks atas setiap tulisan di situs ini. Tanggapan dapat dikirim ke <a href={`mailto:${SITE.replyEmail}`}>{SITE.replyEmail}</a>.</p>
        <p>Tanggapan yang diterima akan dimuat <strong>apa adanya, tanpa penyuntingan</strong>, bersama tulisan yang bersangkutan, lengkap dengan tanggal penerimaan.</p>
        <p class="muted">Jika tidak ada tanggapan, situs tidak menyimpulkan apa pun. Belum adanya tanggapan bukan pengakuan atas apa pun.</p>
      </>
    ) : (
      <>
        <p>Abil Sudarman has the right to respond to, correct, or add context to any piece on this site. Replies can be sent to <a href={`mailto:${SITE.replyEmail}`}>{SITE.replyEmail}</a>.</p>
        <p>Replies received will be published <strong>as received, without editing</strong>, alongside the piece concerned, with the date they were received.</p>
        <p class="muted">If there is no reply, the site draws no conclusion. The absence of a reply is not an admission of anything.</p>
      </>
    )}
  </article>
</BaseLayout>
