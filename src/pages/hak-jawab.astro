---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';
import { formatDateLocale, localizedPath, routePath, type Locale } from '../i18n';
import { getKlaim, getPakar, isGenerated } from '../lib/pakar';
import { replyLine } from '../lib/verdict';
const { locale = 'id' } = Astro.props as { locale?: Locale };
const path = localizedPath('reply', locale);
const T = {
  id: { title: 'Hak jawab para pakar yang disebut', h1: 'Hak jawab', crumb: 'Hak jawab',
    description: 'Cara pakar yang disebut menanggapi isi situs ini: tanggapan dikirim lewat email dan dimuat apa adanya, tanpa penyuntingan, bersama halaman yang bersangkutan.' },
  en: { title: 'Right of reply for experts named', h1: 'Right of reply', crumb: 'Right of reply',
    description: 'How any expert named can respond to this site: replies are sent by email and published as received, without editing, alongside the page concerned.' },
}[locale];
// Reply status of every checked claim, so the procedure above can be checked against what actually happened.
const claimRows = (await getKlaim()).filter((k) => !isGenerated(k));
const pakarList = await getPakar();
const pname = (id: string) => pakarList.find((p) => p.id === id)?.data.name ?? id;
const RS = { id: { h: 'Status tanggapan per klaim', claim: 'Klaim', who: 'Pakar', status: 'Status' }, en: { h: 'Reply status by claim', claim: 'Claim', who: 'Expert', status: 'Status' } }[locale];
---
<BaseLayout title={T.title} description={T.description} path={path} locale={locale} breadcrumbs={[{ name: T.crumb, path }]}>
  <article class="reading">
    <h1>{T.h1}</h1>
    {locale === 'id' ? (
      <>
        <p>Pakar yang disebut berhak menanggapi, mengoreksi, atau menambahkan konteks atas setiap halaman di situs ini. Tanggapan dapat dikirim ke <a href={`mailto:${SITE.replyEmail}`}>{SITE.replyEmail}</a>.</p>
        <p>Tanggapan yang diterima akan dimuat <strong>apa adanya, tanpa penyuntingan</strong>, bersama halaman yang bersangkutan, lengkap dengan tanggal penerimaan.</p>
        <p>Kami menjawab bahwa tanggapan diterima, dan berupaya memuatnya dalam 14 hari kalender. Pakar dapat meminta tanggapan dimuat dengan nama atau tanpa nama alamat surelnya. Untuk koreksi atau penghapusan, lihat <a href={routePath('policy', locale)}>Kebijakan</a>.</p>
        <p>Agar tidak ada yang menanggapi atas nama orang lain, kami memastikan pengirim lebih dulu, misalnya lewat alamat surel institusi atau satu langkah konfirmasi balasan; 14 hari dihitung sejak pengirim terverifikasi. Kami tidak memuat isi yang melanggar hukum, memuat data pribadi pihak ketiga, atau menyamar sebagai orang lain; bagian itu dihitamkan dan kami menyebut alasannya.</p>
        <p class="muted">Jika tidak ada tanggapan, situs tidak menyimpulkan apa pun. Belum adanya tanggapan bukan pengakuan atas apa pun.</p>
      </>
    ) : (
      <>
        <p>Any expert named has the right to respond to, correct, or add context to any page on this site. Replies can be sent to <a href={`mailto:${SITE.replyEmail}`}>{SITE.replyEmail}</a>.</p>
        <p>Replies received will be published <strong>as received, without editing</strong>, alongside the page concerned, with the date they were received.</p>
        <p>We confirm that a reply was received and aim to publish it within 14 calendar days. The sender may ask for their email address to be left out. For corrections or removal, see <a href={routePath('policy', locale)}>Policies</a>.</p>
        <p>So that nobody replies in someone else's name, we first verify the sender, for example through an institutional email address or a one-step confirmation reply; the 14 days run from verification. We do not publish content that is unlawful, contains a third party's personal data, or impersonates another person; such parts are redacted and we say why.</p>
        <p class="muted">If there is no reply, the site draws no conclusion. The absence of a reply is not an admission of anything.</p>
      </>
    )}
    <h2 id="status">{RS.h}</h2>
    <div class="table-scroll">
      <table>
        <thead><tr><th scope="col">{RS.claim}</th><th scope="col">{RS.who}</th><th scope="col">{RS.status}</th></tr></thead>
        <tbody>
          {claimRows.map((k) => (
            <tr>
              <td><a href={localizedPath('claims', locale, k.id)}>{locale === 'id' ? k.data.claim : k.data.claimEn}</a></td>
              <td>{pname(k.data.pakar)}</td>
              <td>{replyLine(k.data, locale, (d) => formatDateLocale(d, locale))}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </article>
</BaseLayout>
