---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';
import { localizedPath, type Locale } from '../i18n';
const { locale = 'id' } = Astro.props as { locale?: Locale };
const path = localizedPath('pagespeed', locale);
const T = {
  id: { title: 'Hasil PageSpeed', h1: 'Hasil PageSpeed', crumb: 'PageSpeed', mobile: 'Seluler', desktop: 'Desktop', limits: 'Batasan', source: 'Sumber:', sourceLabel: 'Meluncurkan abilsudarman.my.id',
    sourceHref: '/kasus/abil-sudarman/artikel/meluncurkan-abilsudarman-my-id-situs-cek-fakta-open-source-dibuat-dengan-tangan-bukan-di-wix', hl: 'id',
    description: 'Hasil Google PageSpeed Insights untuk abilsudarman.my.id: nilai seluler dan desktop, cara membacanya, dan batasannya.',
    mobileAlt: 'Laporan seluler PageSpeed Insights untuk abilsudarman.my.id: Performance, Accessibility, Best Practices, dan SEO masing-masing 100, Agentic Browsing 2/2',
    desktopAlt: 'Laporan desktop PageSpeed Insights untuk abilsudarman.my.id',
    intro: 'Saya menjalankan Google PageSpeed Insights pada halaman utama abilsudarman.my.id pada 5 Oktober 2026 pukul 00.40. Laporan seluler maupun desktop sama-sama memberi nilai berikut.',
    rerunPre: 'Anda dapat', rerun: 'menjalankan ulang laporannya sendiri',
    limitItems: ['Ini hasil uji lab dari satu kali percobaan. Laporan mencatat bahwa skor bersifat perkiraan dan dapat bervariasi.', 'Google belum memiliki data lapangan dari pengguna nyata untuk situs ini.', 'Nilai ini hanya menilai kecepatan, aksesibilitas, praktik terbaik, dan SEO teknis situs ini. Nilai ini tidak menilai isi atau kebenaran klaim di dalamnya.'] },
  en: { title: 'PageSpeed results', h1: 'PageSpeed results', crumb: 'PageSpeed', mobile: 'Mobile', desktop: 'Desktop', limits: 'Limits', source: 'Source:', sourceLabel: 'Launching abilsudarman.my.id',
    sourceHref: '/en/cases/abil-sudarman/articles/meluncurkan-abilsudarman-my-id-situs-cek-fakta-open-source-dibuat-dengan-tangan-bukan-di-wix', hl: 'en',
    description: 'Google PageSpeed Insights results for abilsudarman.my.id: mobile and desktop scores, how to read them, and their limits.',
    mobileAlt: 'PageSpeed Insights mobile report for abilsudarman.my.id: Performance, Accessibility, Best Practices and SEO all 100, Agentic Browsing 2/2',
    desktopAlt: 'PageSpeed Insights desktop report for abilsudarman.my.id',
    intro: 'I ran Google PageSpeed Insights on the home page of abilsudarman.my.id on 5 October 2026 at 00:40. Both the mobile and the desktop report gave the following scores.',
    rerunPre: 'You can', rerun: 're-run the report yourself',
    limitItems: ['This is a lab result from a single run. The report notes that scores are estimates and may vary.', 'Google does not yet have field data from real users for this site.', 'These scores only assess the speed, accessibility, best practices and technical SEO of this site. They do not assess the content or the truth of the claims in it.'] },
}[locale];
const DESCRIPTION = T.description;
const RERUN = 'https://pagespeed.web.dev/analysis/https-abilsudarman-my-id/zlqqztsswy?form_factor=desktop&category=performance&category=accessibility&category=best-practices&category=seo&category=agentic-browsing&hl=' + T.hl;
const SCORES = [
  { label: 'Performance', value: '100' },
  { label: 'Accessibility', value: '100' },
  { label: 'Best Practices', value: '100' },
  { label: 'SEO', value: '100' },
  { label: 'Agentic Browsing', value: '2/2' },
];
const ld = { '@context': 'https://schema.org', '@type': 'WebPage', name: T.title, url: `${SITE.url}${path}`, inLanguage: locale, description: DESCRIPTION };
---
<BaseLayout title={T.title} description={DESCRIPTION} path={path} locale={locale} jsonLd={ld} breadcrumbs={[{ name: T.crumb, path }]}>
  <article class="reading">
    <h1>{T.h1}</h1>
    <p>{T.intro}</p>
    <ul>
      {SCORES.map((s) => <li><strong>{s.label}:</strong> {s.value}</li>)}
    </ul>
    <h2>{T.mobile}</h2>
    <img src="/img/pagespeed-mobile.png" alt={T.mobileAlt} width="1200" loading="lazy" decoding="async" />
    <h2>{T.desktop}</h2>
    <img src="/img/peluncuran-situs-004.png" alt={T.desktopAlt} width="1200" loading="lazy" decoding="async" />
    <p>{T.rerunPre} <a href={RERUN} rel="noopener nofollow">{T.rerun}</a>.</p>
    <h2>{T.limits}</h2>
    <ul>
      {T.limitItems.map((i) => <li>{i}</li>)}
    </ul>
    <p class="muted">{T.source} <a href={T.sourceHref}>{T.sourceLabel}</a>.</p>
  </article>
</BaseLayout>
