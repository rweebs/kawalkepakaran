---
import { readFileSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import SkyStage from '../components/SkyStage.astro';
import VerdictBadge from '../components/VerdictBadge.astro';
import { getKlaim, getPakar } from '../lib/pakar';
import { SITE } from '../lib/site';
import { localizedPath, routePath, type Locale } from '../i18n';
import { HOME_SECTIONS } from '../lib/sky/states';

const { locale = 'id' } = Astro.props as { locale?: Locale };
const pakar = (await getPakar()).sort((a, b) => a.data.name.localeCompare(b.data.name)).slice(0, 6);
const claims = (await getKlaim()).slice(0, 5);
const nameOf = (id: string) => pakar.find((p) => p.id === id)?.data.name ?? id;
const SECTIONS = [...HOME_SECTIONS];
const T = {
  id: {
    title: 'Menguji klaim para pakar',
    description: 'Kawal Kepakaran menguji klaim para pakar: kredensial diperiksa, bukti dibuka, dan setiap pakar yang disebut berhak menjawab.',
    h1: 'Kawal Kepakaran', sub: 'Menguji klaim para pakar',
    lead: 'Siapa pun bisa menyebut diri pakar. Kami memeriksa klaim kepakaran dengan bukti yang bisa dilacak, lalu membuka hasilnya beserta hak jawab. Isinya catatan dan pendapat penulis, bukan putusan.',
    claimsCta: 'Lihat cek klaim', methodCta: 'Cara kami memeriksa',
    emblemAlt: 'Lambang Kawal Kepakaran: gunungan wayang dengan timbangan',
    howH: 'Cara kami memeriksa',
    steps: [
      ['Catat klaim', 'Kutip klaimnya, di mana dan kapan disampaikan.'],
      ['Periksa kredensial dan bukti', 'Tanya penerbit kredensial dan kumpulkan bukti yang bisa dilacak.'],
      ['Beri putusan, buka hak jawab', 'Satu dari empat putusan dengan tingkat keyakinan; pakar yang disebut dapat menjawab.'],
    ],
    methodLink: 'Baca metode lengkap',
    pakarH: 'Pakar yang diperiksa', pakarAll: 'Semua pakar', noPakar: 'Belum ada pakar yang dimuat.',
    claimsH: 'Cek klaim terbaru', claimsAll: 'Semua cek klaim', noClaims: 'Belum ada klaim yang dimuat.',
    caseH: 'Kasus 001: Abil Sudarman',
    caseLead: 'Kasus pertama kami memeriksa klaim kredensial dan jabatan Abil Sudarman, lengkap dengan artikel, bukti, dan linimasa.',
    caseCta: 'Buka Kasus 001',
    contribH: 'Ikut menguji klaim',
    contribLead: 'Kode situs ini open source. Punya dokumen, tangkapan layar, atau sumber yang dapat diperiksa tentang klaim seorang pakar, baik yang memperkuat maupun yang membantah? Kirim lewat GitHub.',
    rules: ['Sertakan sumber yang dapat diperiksa dan tanggal pengambilan.', 'Tutup NIK, NIM, nomor telepon, dan data pribadi lain.', 'Tulis apa yang ditunjukkan dan apa yang tidak dibuktikan.', 'Tanpa rumor, tanpa data pribadi orang yang tidak terkait.'],
    how: 'Cara berkontribusi', send: 'Kirim bukti atau klaim (Issue)',
    answerH: 'Jawaban', answerLead: 'Setiap pakar yang disebut berhak menanggapi, mengoreksi, atau menambahkan konteks atas setiap halaman di sini.',
    answerMuted: 'Tanggapan yang diterima dimuat apa adanya. Belum adanya tanggapan bukan pengakuan atas apa pun.', replyCta: 'Hak jawab',
    alt: { name: SITE.name, alternateName: 'Kawal Pakar' },
  },
  en: {
    title: 'Checking what experts claim',
    description: 'Kawal Kepakaran checks what experts claim: credentials verified, evidence opened, and every expert named has the right to reply.',
    h1: 'Kawal Kepakaran', sub: 'Checking what experts claim',
    lead: 'Anyone can call themselves an expert. We check claims of expertise against evidence that can be traced, then publish the result together with the right of reply. What you read is the author\'s notes and opinion, not a ruling.',
    claimsCta: 'See the claim checks', methodCta: 'How we check',
    emblemAlt: 'Kawal Kepakaran emblem: a wayang gunungan holding a pair of scales',
    howH: 'How we check',
    steps: [
      ['Record the claim', 'Quote it, and where and when it was made.'],
      ['Check credentials and evidence', 'Ask the credential issuer and gather evidence that can be traced.'],
      ['Give a verdict, open the reply', 'One of four verdicts with a confidence level; the expert named can respond.'],
    ],
    methodLink: 'Read the full method',
    pakarH: 'Experts checked', pakarAll: 'All experts', noPakar: 'No experts have been listed yet.',
    claimsH: 'Latest claim checks', claimsAll: 'All claim checks', noClaims: 'No claim checks have been listed yet.',
    caseH: 'Case 001: Abil Sudarman',
    caseLead: 'Our first case checks Abil Sudarman\'s claimed credentials and roles, with articles, evidence and a timeline.',
    caseCta: 'Open Case 001',
    contribH: 'Help check claims',
    contribLead: 'This site\'s code is open source. Do you have documents, screenshots or sources that can be checked about an expert\'s claim, whether they support or contradict it? Send them through GitHub.',
    rules: ['Include a checkable source and the date it was captured.', 'Mask ID numbers, student numbers, phone numbers and other personal data.', 'Write what the item shows and what it does not prove.', 'No rumours, and no personal data of unrelated people.'],
    how: 'How to contribute', send: 'Submit evidence or a claim (Issue)',
    answerH: 'Reply', answerLead: 'Every expert named has the right to respond, correct, or add context to any page here.',
    answerMuted: 'Responses received are published as received. The absence of a response is not an admission of anything.', replyCta: 'Right of reply',
    alt: { name: SITE.name, alternateName: 'Expert Watch' },
  },
}[locale];
// The emblem is inlined: as an <img> its request was only discovered after the inline CSS, which delayed the LCP by hundreds of ms.
const emblem = readFileSync('public/logo-kawal.svg', 'utf8')
  .replace(/aria-label="[^"]*"/, `aria-label="${T.emblemAlt}"`)
  .replace('<svg ', '<svg width="320" height="320" ');
const websiteLd = {
  '@context': 'https://schema.org', '@type': 'WebSite', name: T.alt.name, alternateName: T.alt.alternateName,
  '@id': `${SITE.url}/#website`, url: new URL(localizedPath('home', locale), SITE.url).toString(), sameAs: [SITE.url, SITE.repo],
  inLanguage: locale, description: T.description,
  author: { '@type': 'Person', name: SITE.author },
  publisher: { '@type': 'Organization', '@id': 'https://www.infraloka.co.id/#organization', name: 'Infraloka', url: 'https://www.infraloka.co.id' },
};
---
<BaseLayout title={T.title} description={T.description} path={localizedPath('home', locale)} locale={locale} jsonLd={websiteLd}>
  <SkyStage sectionIds={SECTIONS} />
  <div class="home-main">
    <section id="operasi" class="home-section container">
      <div class="home-hero">
        <div class="glass stack">
          <div class="stack">
            <h1>{T.h1}</h1>
            <p class="hero-sub">{T.sub}</p>
            <p class="lead muted">{T.lead}</p>
            <div class="btn-row">
              <a class="btn" href={routePath('claims', locale)}>{T.claimsCta}</a>
              <a class="btn" href={routePath('method', locale)}>{T.methodCta}</a>
            </div>
          </div>
        </div>
        <figure class="home-hero__art">
          <Fragment set:html={emblem} />
        </figure>
      </div>
    </section>

    <section id="siapa" class="home-section container home-pair">
      <div class="glass stack">
        <h2>{T.howH}</h2>
        <ol class="stack">
          {T.steps.map(([h, p]) => <li><strong>{h}.</strong> {p}</li>)}
        </ol>
        <p><a href={routePath('method', locale)}>{T.methodLink} →</a></p>
      </div>
      <div class="glass stack">
        <h2>{T.pakarH}</h2>
        {pakar.length === 0 ? (
          <p class="muted">{T.noPakar}</p>
        ) : (
          <ul class="stack">
            {pakar.map((p) => <li><a href={localizedPath('experts', locale, p.id)}>{p.data.name}</a> <span class="muted">· {p.data.field}</span></li>)}
          </ul>
        )}
        <p><a href={routePath('experts', locale)}>{T.pakarAll} →</a></p>
      </div>
    </section>

    <section id="bukti" class="home-section container">
      <div class="glass stack">
        <h2>{T.claimsH}</h2>
        {claims.length === 0 ? (
          <p class="muted">{T.noClaims}</p>
        ) : (
          <ul class="stack">
            {claims.map((k) => (
              <li>
                <a href={localizedPath('claims', locale, k.id)}>{locale === 'id' ? k.data.claim : k.data.claimEn}</a>{' '}
                <VerdictBadge verdict={k.data.verdict} locale={locale} />
                <span class="muted"> · {nameOf(k.data.pakar)}</span>
              </li>
            ))}
          </ul>
        )}
        <p><a href={routePath('claims', locale)}>{T.claimsAll} →</a></p>
        <h3>{T.caseH}</h3>
        <p>{T.caseLead}</p>
        <a class="btn" href={routePath('caseHome', locale)}>{T.caseCta}</a>
      </div>
    </section>

    <section id="kontribusi" class="home-section container">
      <div class="glass stack">
        <h2>{T.contribH}</h2>
        <p class="lead">{T.contribLead}</p>
        <ul class="kontribusi-rules muted">
          {T.rules.map((r) => <li>{r}</li>)}
        </ul>
        <div class="btn-row">
          <a class="btn" href={`${SITE.repo}/blob/main/CONTRIBUTING.md`} rel="noopener" target="_blank">{T.how}</a>
          <a class="btn" href={`${SITE.repo}/issues/new/choose`} rel="noopener" target="_blank">{T.send}</a>
        </div>
      </div>
    </section>

    <section id="jawaban" class="home-section container">
      <div class="glass stack">
        <h2>{T.answerH}</h2>
        <p class="lead">{T.answerLead}</p>
        <p class="muted lead">{T.answerMuted}</p>
        <a class="btn" href={routePath('reply', locale)}>{T.replyCta}</a>
      </div>
    </section>
  </div>
</BaseLayout>
