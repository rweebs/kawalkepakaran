---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArsip, getPihak, arsipPath, pihakPath, KIND_LABEL, STATUS_LABEL, PIHAK_KIND_LABEL } from '../../lib/arsip';
import { UI } from '../../i18n/ui';
import { formatDateLocale, localizedPath, routePath, type Locale } from '../../i18n';

export async function getStaticPaths() {
  return (await getPihak()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
// Indonesian page. The English page (src/pages/en/parties/[slug].astro) passes locale="en".
const { entry, locale = 'id' } = Astro.props as { entry: any; locale?: Locale };
const p = entry.data;
const path = pihakPath(entry.id, locale);
const articles = (await getArsip()).filter((a) => p.articles.includes(a.id)).sort((a, b) => a.data.title.localeCompare(b.data.title));
const interest = locale === 'id' ? p.interest : p.interestEn;
const limits = locale === 'id' ? p.limits : p.limitsEn;
const T = {
  id: { crumb: 'Pihak', posts: 'Tulisan yang menyebut pihak ini', status: 'Status', interest: 'Kepentingan penulis', limits: 'Yang tidak dibuktikan',
    updated: 'Diperbarui', reply: 'Pihak ini berhak menjawab, mengoreksi, atau menambahkan konteks lewat', replyLabel: 'hak jawab',
    intro: 'Halaman ini hanya merangkum tulisan penulis yang menyebut pihak ini. Ini bukan penilaian atas pihak itu.' },
  en: { crumb: 'Parties', posts: 'Posts that name this party', status: 'Status', interest: 'The author\'s interest', limits: 'What this does not prove',
    updated: 'Updated', reply: 'This party has the right to respond, correct or add context through the', replyLabel: 'right of reply',
    intro: 'This page only summarises the author\'s posts that name this party. It is not an assessment of that party.' },
}[locale];
---
<BaseLayout title={p.name} description={`${p.name}: ${T.intro}`} path={path} locale={locale} noindex
  breadcrumbs={[{ name: T.crumb, path: localizedPath('parties', locale) }, { name: p.name, path }]}>
  <article class="reading">
    <h1>{p.name}</h1>
    <p class="lead">{PIHAK_KIND_LABEL[p.kind as keyof typeof PIHAK_KIND_LABEL][locale]}</p>
    <p class="muted">{UI[locale].disclaimer}</p>
    <p>{T.intro}</p>
    <section aria-labelledby="posts-h">
      <h2 id="posts-h">{T.posts}</h2>
      <ul class="stack">
        {articles.map((a) => (
          <li>
            <a href={arsipPath(a.id, locale)}>{a.data.title}</a>
            <span class="muted"> · {KIND_LABEL[a.data.kind as keyof typeof KIND_LABEL][locale]} · {T.status}: {STATUS_LABEL[a.data.status as keyof typeof STATUS_LABEL][locale]}</span>
          </li>
        ))}
      </ul>
    </section>
    <section aria-labelledby="int-h">
      <h2 id="int-h">{T.interest}</h2>
      <p>{interest}</p>
    </section>
    <section aria-labelledby="lim-h">
      <h2 id="lim-h">{T.limits}</h2>
      <p>{limits}</p>
    </section>
    <p class="muted">{T.updated}: {formatDateLocale(p.updatedAt, locale)}</p>
    <p class="notice">{T.reply} <a href={routePath('reply', locale)}>{T.replyLabel}</a>.</p>
  </article>
</BaseLayout>
