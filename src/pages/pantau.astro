---
// Pantau: Rahmat Wibowo as the target of three sources, and his legal response, on one page.
// Order follows the harm: summary and chapters, the relationship map and cross-source findings, then
// 1. Fomo (posts about him from Sep 2023; src/data/fomo.json, made by scripts/make-fomo-data.mjs),
// 2. the rahmatwibowo.net site (from its own sitemap; src/data/sitemap-watch.json, scripts/snapshot-sitemap.mjs),
// 3. Gelar Perkara, his case-review file (src/data/perkara.json, scripts/make-perkara-data.mjs; no domiciles, identity
//    details or Lampiran names), and how every number is counted.
// Every dashboard is server-rendered; its interactive version fetches its data from /pantau-data/<name>.json when it
// scrolls into view (src/components/PantauLazy.tsx), so the HTML does not carry each dataset a second time.
import { execFileSync } from 'node:child_process';
import BaseLayout from '../layouts/BaseLayout.astro';
import SitemapDashboard from '../components/SitemapDashboard';
import PerkaraDashboard from '../components/PerkaraDashboard';
import FomoDashboard from '../components/FomoDashboard';
import CrossInsights from '../components/CrossInsights';
import RelasiGraph from '../components/RelasiGraph';
import PantauLazy from '../components/PantauLazy';
import PantauHero from '../components/PantauHero';
import { HarmResponseChart, HarmTreemap, OperatorFocus } from '../components/PantauHarm';
import ProvenanceStrip from '../components/ProvenanceStrip';
import PantauEvidence, { type CrawlCoverage } from '../components/PantauEvidence';
import { RedactionLedger, NoticeLog, LinkStatus, type NoticeEntry, type LinkStatusEntry } from '../components/PantauLedger';
import PantauMethod from '../components/PantauMethod';
import PantauFullscreen from '../components/PantauFullscreen';
import '../styles/pantau-3d.css';
import '../styles/pantau-insights.css';
import '../styles/pantau-perkara.css';
import '../styles/pantau-fomo.css';
import '../styles/pantau-page.css';
import { watch as data, perkara, fomo, fomoDossier, rows, relasiProps, situsProps, islandSrc } from '../lib/pantau-props';
import { snapshotAgeDays, WATCH_ORIGIN } from '../lib/sitemap-watch';
import { hero, harmVsResponse, harmCategories, operatorFocus, removals, imagesBySection, slugVsFirstSeen, archiveCoverage } from '../lib/pantau-page';
import { sha256File, dataChangelog, redactionLedger, privacyChecks, optionalJson } from '../lib/pantau-provenance';
import { UI } from '../i18n/ui';
import { formatDateLocale, localizedPath, routePath, type Locale } from '../i18n';
import { pageLd } from '../lib/schema-org';
import { GAME_COPY } from '../lib/bowobharata-game/copy';
const { locale = 'id' } = Astro.props as { locale?: Locale };
const first = data.snapshots[0]?.date;
const latestSnap = data.snapshots.at(-1);
const latest = latestSnap?.date;
// Age at build time, counted in Jakarta days like the snapshots themselves.
const buildDay = new Date(Date.now() + 7 * 3600_000).toISOString().slice(0, 10);
const age = latest ? snapshotAgeDays(latest, buildDay) : 0;
const STALE_DAYS = 7;
const sha = latestSnap?.provenance?.sha256;
const j = perkara.meta.jumlah;
const relasi = relasiProps();
const situs = situsProps(locale);
const cross = { site: rows, fomo: fomo.posts, kronologis: perkara.kronologis, laporan: perkara.laporan, terlapor: perkara.terlapor };
const heroData = hero({ ...cross, siteTotal: rows.length, fomoThreads: fomo.threads.length }, buildDay);
const harmResp = harmVsResponse(cross);
const harmCats = harmCategories(perkara.terlapor);
const focus = operatorFocus(rows, perkara.terlapor);
// Provenance: hashes of exactly what this page publishes, and the data changelog from git.
const DATA_FILES = ['src/data/sitemap-watch.json', 'src/data/perkara.json', 'src/data/fomo.json'];
const git = (args: string[]) => execFileSync('git', args, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'], timeout: 10_000 });
const shaPerkara = sha256File('src/data/perkara.json');
const shaFomo = sha256File('src/data/fomo.json');
const changes = dataChangelog(git, DATA_FILES);
const perkaraText = JSON.stringify(perkara);
const fomoText = JSON.stringify(fomo);
const redaction = redactionLedger(perkaraText, fomoText, j);
const checks = privacyChecks(perkaraText, fomoText);
// Hand-kept or script-written logs; absent until someone records them, and then shown as recorded.
const notices = optionalJson<NoticeEntry[]>('src/data/notice-log.json');
const links = optionalJson<LinkStatusEntry[]>('src/data/fomo-link-status.json');
const crawl = optionalJson<CrawlCoverage>('src/data/crawl-coverage.json');
const T = {
  id: {
    title: 'Pantau: rahmatwibowo.net, Gelar Perkara, dan Fomo', h1: 'Pantau',
    description: 'Tiga dasbor dalam satu halaman: pertumbuhan situs rahmatwibowo.net dari sitemap publiknya, berkas gelar perkara terpadu yang diajukan Rahmat Wibowo ke Ditressiber Polda Metro Jaya, dan postingan tentang Pelapor di Fomo 2023–2026. Semua terlapor berstatus dugaan.',
    lead: 'Halaman ini memantau tiga hal: seberapa cepat situs yang menyebut penggagas Kawal Kepakaran sebagai pelaku pelecehan bertambah, bagaimana laporan Pelapor terhadap pihak-pihak yang ia duga mencemarkan namanya ditangani, dan apa yang ditulis tentang dirinya di Fomo.',
    secRelasi: 'Peta hubungan', relasiH: 'Peta hubungan: semuanya mengarah ke satu orang',
    harmH: 'Serangan, jawaban, dan jenis dugaan perbuatan', secMethod: 'Cara menghitung',
    provSitus: 'Situs rahmatwibowo.net', provPerkara: 'Gelar Perkara', provFomo: 'Fomo', disusun: 'Disusun', dihimpun: 'Dihimpun',
    srcPerkara: 'Berkas Pelapor: Gelar Perkara Terpadu, Dokumen 1', srcFomo: (n: number) => `Bukti Pelapor dari fomo.id (${n} thread)`,
    archSitus: (d: string) => `source/sitemap-watch/${d}.xml.gz (sitemap mentah)`, archRepo: (f: string) => `${f} di repositori`,
    jump: 'Lompat ke', sec1: 'Situs rahmatwibowo.net', sec2: 'Gelar Perkara',
    sec1Lead: 'Situs rahmatwibowo.net menyebut penggagas Kawal Kepakaran sebagai pelaku pelecehan. Bagian ini tidak menilai isinya; ia hanya mencatat seberapa cepat situs itu bertambah, dari sitemap yang ia terbitkan sendiri.',
    howTitle: 'Cara membaca angka ini',
    how: [
      'Pertumbuhan yang sebenarnya hanya bisa dilihat dari snapshot: salinan sitemap yang disimpan setiap kali situs ini dibangun. Snapshot pertama tercatat pada {first}; sebelum tanggal itu tidak ada arsip sitemap (Wayback Machine juga tidak menyimpannya).',
      'Tanggal di slug (misalnya ev-20260607-…) ditulis sendiri oleh pengelola situs. Itu tanggal yang ia berikan pada item, bukan bukti kapan halaman tayang.',
      'lastmod adalah tanggal terakhir halaman diubah. Ratusan halaman sering berubah pada hari yang sama karena pembangunan ulang massal, jadi lastmod mengukur aktivitas edit, bukan halaman baru.',
    ],
    source: 'Sumber', updated: 'Snapshot terakhir',
    age: (n: number) => (n === 0 ? 'hari ini' : `${n} hari lalu`),
    stale: (n: number) => `Perhatian: data ini berumur ${n} hari. Snapshot baru belum dicatat, jadi angka di bawah mungkin tertinggal dari isi situs saat ini.`,
    hash: 'SHA-256 sitemap mentah', hashTitle: 'SHA-256 lengkap dari sitemap mentah; salinannya tersimpan di repositori (source/sitemap-watch) agar bisa diperiksa ulang',
    linkNote: 'Tautan ke rahmatwibowo.net diberi rel="nofollow" agar halaman ini tidak menaikkan peringkat situs tersebut di mesin pencari.',
    status: 'Status: semua terlapor di bagian ini adalah dugaan Pelapor (Rahmat Wibowo), bukan temuan polisi atau putusan pengadilan. Asas praduga tak bersalah berlaku. Siapa pun yang disebut dapat menggunakan hak jawab.',
    about: 'Bagian ini menampilkan berkas yang disusun Pelapor sebagai bahan gelar perkara terpadu. Isinya klaim Pelapor; sebagian dibaca dari salinan pindai dan wajib dicocokkan dengan dokumen asli.',
    withheldH: 'Yang sengaja tidak ditampilkan',
    withheld: (a: number, c: number) => [
      'Domisili, identitas lengkap, dan daftar akun setiap terlapor.',
      `Nama ${a} pihak di Lampiran A (berkas sendiri menilai buktinya belum cukup) dan ${c} nama di Lampiran C; ditampilkan sebagai jumlah, dan namanya disamarkan menjadi [nama di lampiran] bila muncul di teks lain.`,
      'Alamat jalan di dalam teks (ditulis [alamat]), nama berkas sumber, dan hasil OCR mentah.',
    ],
    made: 'Berkas disusun', limitsH: 'Keterbatasan menurut berkas', reply: 'Hak jawab',
    sec3: 'Fomo',
    fomoLead: 'Postingan tentang Pelapor di platform Fomo (fomo.id), 2023–2026, yang dihimpun Pelapor sebagai bukti dugaan pencemaran nama baik, fitnah, penghinaan, ancaman, dan doxxing. Perkara ini diadukan terpisah dari gelar perkara di atas.',
    fomoStatus: 'Akun Fomo bersifat anonim; halaman ini hanya menampilkan nama akun. Lencana perusahaan adalah yang ditampilkan Fomo di sebelah nama akun, bukan bukti bahwa perusahaan itu terlibat atau bertanggung jawab. Isi postingan adalah dugaan Pelapor sebagai bukti, bukan temuan polisi.',
    fomoNotesH: 'Catatan tentang data ini', fomoExcluded: (n: number) => `${n} akun yang menurut berkas hanya tampil di kartu "Thread yang relevan" tidak dimasukkan ke tabel akun dan perusahaan; postingannya tetap ditampilkan tanpa lencana.`,
  },
  en: {
    title: 'Monitor: rahmatwibowo.net, the case review and Fomo', h1: 'Monitor',
    description: "Three dashboards on one page: the growth of rahmatwibowo.net from its public sitemap, the integrated case-review file Rahmat Wibowo submitted to Ditressiber Polda Metro Jaya, and posts about the Pelapor on Fomo, 2023–2026. Every terlapor is an allegation.",
    lead: "This page tracks three things: how fast the site that calls the founder of Kawal Kepakaran a harasser is growing, how the Pelapor's reports against the parties he believes defamed him are being handled, and what was written about him on Fomo.",
    secRelasi: 'Relationship map', relasiH: 'Relationship map: everything points at one person',
    harmH: 'Attacks, answers and kinds of alleged acts', secMethod: 'How it is counted',
    provSitus: 'rahmatwibowo.net site', provPerkara: 'Case review', provFomo: 'Fomo', disusun: 'Prepared', dihimpun: 'Collected',
    srcPerkara: "Pelapor's file: Gelar Perkara Terpadu, Document 1", srcFomo: (n: number) => `Pelapor's evidence from fomo.id (${n} threads)`,
    archSitus: (d: string) => `source/sitemap-watch/${d}.xml.gz (raw sitemap)`, archRepo: (f: string) => `${f} in the repository`,
    jump: 'Jump to', sec1: 'The rahmatwibowo.net site', sec2: 'Case review (Gelar Perkara)',
    sec1Lead: "rahmatwibowo.net calls the founder of Kawal Kepakaran a harasser. This section does not assess that content; it only records how fast the site grows, from the sitemap the site itself publishes.",
    howTitle: 'How to read these numbers',
    how: [
      'True growth can only be seen from snapshots: copies of the sitemap saved each time this site is built. The first snapshot was recorded on {first}; there is no sitemap archive before that date (the Wayback Machine holds none either).',
      "The date in a slug (e.g. ev-20260607-…) is written by the site's operator. It is the date they gave the item, not proof of when the page went live.",
      'lastmod is the date a page was last changed. Hundreds of pages often change on the same day in a bulk rebuild, so lastmod measures edit activity, not new pages.',
    ],
    source: 'Source', updated: 'Latest snapshot',
    age: (n: number) => (n === 0 ? 'today' : `${n} days ago`),
    stale: (n: number) => `Note: this data is ${n} days old. No newer snapshot has been recorded, so the numbers below may lag behind the site today.`,
    hash: 'SHA-256 of raw sitemap', hashTitle: 'Full SHA-256 of the raw sitemap; a copy is kept in the repository (source/sitemap-watch) so it can be re-checked',
    linkNote: 'Links to rahmatwibowo.net carry rel="nofollow" so this page does not lift that site in search rankings.',
    status: "Status: every terlapor in this section is an allegation by the Pelapor (Rahmat Wibowo), not a police finding or a court ruling. The presumption of innocence applies. Anyone named can use the right of reply.",
    about: "This section shows the file the Pelapor prepared for an integrated case review. Its content is the Pelapor's claim; part of it was read from scanned copies and must be checked against the originals. Text is in Indonesian.",
    withheldH: 'What is deliberately not shown',
    withheld: (a: number, c: number) => [
      "Each terlapor's domicile, full identity and account list.",
      `The names of ${a} parties in Appendix A (the file itself judges their evidence insufficient) and ${c} names in Appendix C; shown as counts, and masked as [nama di lampiran] where they appear in other text.`,
      'Street addresses inside the text (written [alamat]), source file names and raw OCR output.',
    ],
    made: 'File prepared', limitsH: 'Limitations stated in the file', reply: 'Right of reply',
    sec3: 'Fomo',
    fomoLead: "Posts about the Pelapor on the Fomo platform (fomo.id), 2023–2026, collected by the Pelapor as evidence of alleged defamation, slander, insults, threats and doxxing. This matter was reported separately from the case review above.",
    fomoStatus: "Fomo accounts are anonymous; this page shows only account names. A company badge is what Fomo displays next to an account name, not evidence that the company is involved or responsible. The posts are the Pelapor's evidence of an allegation, not a police finding.",
    fomoNotesH: 'Notes on this data', fomoExcluded: (n: number) => `${n} accounts that the files say appear only on "related thread" cards are left out of the account and company tables; their posts are still shown, without a badge.`,
  },
}[locale];
const fmt = (d?: string) => (d ? formatDateLocale(d, locale) : '–');
const path = localizedPath('monitor', locale);
const replyHref = routePath('reply', locale);
const caseHref = (id: string) => `#terlapor-${id}`;
const ld = [pageLd({ type: 'CollectionPage', name: T.title, path, locale, description: T.description })];
---
<BaseLayout title={T.title} description={T.description} path={path} locale={locale} jsonLd={ld} breadcrumbs={[{ name: T.h1, path }]}>
  <div class="container pad-block pantau">
    <h1>{T.h1}</h1>
    <p class="muted">{UI[locale].disclaimer}</p>
    <div class="stage3d__entry"><PantauFullscreen client:idle locale={locale} /></div>
    <PantauHero hero={heroData} locale={locale} />
    <p class="pantau__game">{GAME_COPY[locale].entryNote} <a class="btn" href={routePath('bowobharataGame', locale)}>{GAME_COPY[locale].entryLink}</a></p>

    <section id="relasi" class="pantau__section" aria-labelledby="relasi-h">
      <h2 id="relasi-h">{T.relasiH}</h2>
      <PantauLazy client:visible kind="relasi" src={islandSrc('relasi')} props={{ locale }}>
        <RelasiGraph {...relasi} locale={locale} />
      </PantauLazy>
    </section>

    <div class="pantau-cross">
      <CrossInsights {...cross} locale={locale} />
    </div>

    <section id="serangan" class="pantau__section" aria-labelledby="serangan-h">
      <h2 id="serangan-h">{T.harmH}</h2>
      {harmResp && <HarmResponseChart data={harmResp} locale={locale} />}
      <div class="pg-pair">
        <HarmTreemap cats={harmCats} locale={locale} />
        <OperatorFocus rows={focus} locale={locale} anchor={caseHref} />
      </div>
    </section>

    <section id="fomo" class="pantau__section" aria-labelledby="fomo-h">
      <h2 id="fomo-h">{T.sec3}</h2>
      <p class="notice pk-status"><strong>{T.fomoStatus}</strong> <a href={replyHref}>{T.reply}</a></p>
      <p>{T.fomoLead}</p>
      <details class="pantau__how">
        <summary>{T.fomoNotesH}</summary>
        <ul>{fomo.meta.catatan.map((c) => <li>{c}</li>)}<li>{T.fomoExcluded(fomo.meta.dikecualikan)}</li></ul>
      </details>
      <PantauLazy client:visible kind="fomo" src={islandSrc('fomo')} props={{ locale }}>
        <FomoDashboard data={fomo} dossier={fomoDossier} locale={locale} />
      </PantauLazy>
      <LinkStatus entries={links} locale={locale} />
      <ProvenanceStrip title={T.provFomo} locale={locale} p={{ source: T.srcFomo(fomo.threads.length), captured: fomo.meta.dibuat, capturedLabel: T.dihimpun, sha256: shaFomo, hashOf: 'src/data/fomo.json', archive: T.archRepo('src/data/fomo.json'), generated: buildDay }} />
    </section>

    <section id="situs" class="pantau__section" aria-labelledby="situs-h">
      <h2 id="situs-h">{T.sec1}</h2>
      <p>{T.sec1Lead}</p>
      <p class="muted pantau__meta">{T.source}: <a href={`${WATCH_ORIGIN}/sitemap.xml`} rel="nofollow ugc noopener noreferrer">rahmatwibowo.net/sitemap.xml</a> · {T.updated}: {fmt(latest)} ({T.age(age)}){sha && <> · {T.hash}: <code title={`${T.hashTitle}: ${sha}`}>{sha.slice(0, 12)}…</code></>}</p>
      {age > STALE_DAYS && <aside class="notice" role="status"><p><strong>{T.stale(age)}</strong></p></aside>}
      <details class="pantau__how">
        <summary>{T.howTitle}</summary>
        <ul>{T.how.map((h) => <li>{h.replace('{first}', fmt(first))}</li>)}</ul>
        <p class="muted">{T.linkNote}</p>
      </details>
      <PantauLazy client:visible kind="situs" src={islandSrc(locale === 'en' ? 'situs-en' : 'situs-id')} props={{ locale }}>
        <SitemapDashboard {...situs} locale={locale} />
      </PantauLazy>
      <PantauEvidence listed={rows.filter((r) => !r.removed).length} snapshots={data.snapshots.length} firstSnapshot={first ?? buildDay}
        removed={removals(rows)} archive={archiveCoverage(data.snapshots, rows.filter((r) => !r.removed).length)}
        images={imagesBySection(rows)} gap={slugVsFirstSeen(rows, first ?? buildDay)} crawl={crawl} locale={locale} />
      <ProvenanceStrip title={T.provSitus} locale={locale} p={{ source: 'rahmatwibowo.net/sitemap.xml', sourceHref: `${WATCH_ORIGIN}/sitemap.xml`, captured: latestSnap?.provenance?.fetchedAt ?? latest ?? null, sha256: sha ?? null, hashOf: 'sitemap.xml', archive: latest ? T.archSitus(latest) : '–', generated: buildDay }} />
    </section>

    <section id="gelar-perkara" class="pantau__section" aria-labelledby="gelar-perkara-h">
      <h2 id="gelar-perkara-h">{T.sec2}</h2>
      <p class="notice pk-status"><strong>{T.status}</strong> <a href={replyHref}>{T.reply}</a></p>
      <p>{T.about}</p>
      <p class="muted pantau__meta">{T.made}: {fmt(perkara.meta.dibuat)}{perkara.meta.peruntukan && <> · {perkara.meta.peruntukan}</>}</p>
      <details class="pantau__how">
        <summary>{T.withheldH}</summary>
        <ul>{T.withheld(j.terlapor_lampiran_a ?? 0, j.lampiranC ?? 0).map((w) => <li>{w}</li>)}</ul>
      </details>
      <details class="pantau__how">
        <summary>{T.limitsH}</summary>
        <ul>{perkara.meta.keterbatasan.map((k) => <li>{k}</li>)}</ul>
      </details>
      <PantauLazy client:visible kind="perkara" src={islandSrc('perkara')} props={{ locale, replyHref }}>
        <PerkaraDashboard data={perkara} locale={locale} replyHref={replyHref} />
      </PantauLazy>
      <div class="pg-pair">
        <RedactionLedger r={redaction} checks={checks} locale={locale} />
        <NoticeLog entries={notices} named={perkara.terlapor.length} locale={locale} />
      </div>
      <ProvenanceStrip title={T.provPerkara} locale={locale} p={{ source: T.srcPerkara, captured: perkara.meta.dibuat, capturedLabel: T.disusun, sha256: shaPerkara, hashOf: 'src/data/perkara.json', archive: T.archRepo('src/data/perkara.json'), generated: buildDay }} />
    </section>

    <PantauMethod changes={changes} locale={locale} hashes={[
      { label: 'sitemap.xml', sha256: sha ?? null }, { label: 'perkara.json', sha256: shaPerkara }, { label: 'fomo.json', sha256: shaFomo },
    ]} />
  </div>
  <script>
    // Print / save as PDF, stamped with the exact URL (filters included) and the print time.
    const stampUrl = document.querySelector('[data-pantau-stamp-url]');
    const stampDate = document.querySelector('[data-pantau-stamp-date]');
    const stamp = () => {
      if (stampUrl) stampUrl.textContent = location.href;
      if (stampDate) stampDate.textContent = new Date().toISOString();
    };
    window.addEventListener('beforeprint', stamp);
    document.querySelectorAll<HTMLButtonElement>('[data-pantau-print]').forEach((b) => b.addEventListener('click', () => { stamp(); window.print(); }));
  </script>
</BaseLayout>
