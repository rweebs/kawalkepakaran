---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VerdictBadge from '../../components/VerdictBadge.astro';
import { getKlaim, getPakar, isGenerated } from '../../lib/pakar';
import { getArsip, arsipPath } from '../../lib/arsip';
import { getBukti } from '../../lib/content';
import { truncateAtWord } from '../../lib/seo';
import { claimReviewLd } from '../../lib/schema-org';
import { PAGE_LASTMOD, SITE } from '../../lib/site';
import { sourceLineFor } from '../../lib/bukti';
import { confidenceLabel, replyStatusLabel, verdictLabel } from '../../lib/verdict';
import { formatDateLocale, localizedPath, routePath, type Locale } from '../../i18n';

export async function getStaticPaths() {
  return (await getKlaim()).map((k) => ({ params: { slug: k.id }, props: { id: k.id } }));
}
// Indonesian page. The English page (src/pages/en/claims/[slug].astro) passes locale="en".
const { id, locale = 'id' } = Astro.props as { id: string; locale?: Locale };
const klaim = (await getKlaim()).find((k) => k.id === id)!;
const pakar = (await getPakar()).find((p) => p.id === klaim.data.pakar)!;
const evidence = (await getBukti()).filter((b) => klaim.data.evidence.includes(b.id)).sort((a, b) => a.data.order - b.data.order);
const generated = isGenerated(klaim);
const docs = (await getArsip()).filter((a) => (klaim.data.articles ?? []).includes(a.id));
const claim = locale === 'id' ? klaim.data.claim : klaim.data.claimEn;
const limits = locale === 'id' ? klaim.data.limits : klaim.data.limitsEn;
const path = localizedPath('claims', locale, id);
const alternates = { id: localizedPath('claims', 'id', id), en: localizedPath('claims', 'en', id) };
const reviewedIso = klaim.data.reviewedAt?.toISOString().slice(0, 10) ?? PAGE_LASTMOD['/klaim'];
const canonicalUrl = new URL(path, SITE.url).toString();
const ld = claimReviewLd({
  url: canonicalUrl, claim, pakarName: pakar.data.name, verdictLabel: verdictLabel(klaim.data.verdict, locale),
  limits, datePublished: reviewedIso, pakarUrl: new URL(localizedPath('experts', locale, pakar.id), SITE.url).toString(), locale, claimMadeAt: klaim.data.madeAt?.toISOString().slice(0, 10),
});
const description = truncateAtWord(`${verdictLabel(klaim.data.verdict, locale)}: ${claim} ${pakar.data.name}. ${limits}`, 160);
const citation = `${SITE.name}, "${claim.replace(/"/g, "'")}", ${canonicalUrl}, ${locale === 'id' ? 'ditinjau' : 'reviewed'} ${reviewedIso}.`;
const reply = klaim.data.reply;
const replyText = reply && (locale === 'en' && reply.textEn ? reply.textEn : reply.text);
const T = {
  id: { crumb: 'Cek klaim', by: 'Pakar', venue: 'Disampaikan di', madeAt: 'Tanggal', verdict: 'Putusan pemeriksaan', confidence: 'Tingkat keyakinan',
    evidence: 'Bukti', reviewed: 'Terakhir ditinjau', cite: 'Kutip halaman ini', copy: 'Salin tautan', copied: 'Tautan disalin', medical: 'Catatan kesehatan: halaman ini memeriksa sebuah klaim, bukan memberi nasihat medis. Untuk keputusan kesehatan, tanyakan tenaga medis berizin.', replyReceived: 'Tanggapan diterima', replyAsReceived: 'Disajikan apa adanya, tanpa penyuntingan.', replyRequested: 'Tanggapan diminta', noEvidence: 'Belum ada bukti yang ditautkan.', doc: 'Dokumen', limits: 'Yang tidak dibuktikan', reply: 'Tanggapan', replyLink: 'Hak jawab' },
  en: { crumb: 'Claim checks', by: 'Expert', venue: 'Made at', madeAt: 'Date', verdict: 'Verdict', confidence: 'Confidence',
    evidence: 'Evidence', reviewed: 'Last reviewed', cite: 'Cite this page', copy: 'Copy link', copied: 'Link copied', medical: 'Health note: this page checks a claim; it is not medical advice. For health decisions, ask a licensed clinician.', replyReceived: 'Reply received', replyAsReceived: 'Shown as received, unedited.', replyRequested: 'Reply requested', noEvidence: 'No evidence linked yet.', doc: 'Document', limits: 'What this does not prove', reply: 'Reply', replyLink: 'Right of reply' },
}[locale];
---
<BaseLayout title={truncateAtWord(claim.replace(/["“”]/g, ''), 48)} description={description} path={path} locale={locale} alternates={alternates} jsonLd={generated ? undefined : ld} noindex={generated}
  breadcrumbs={[{ name: T.crumb, path: routePath('claims', locale) }, { name: claim, path }]}>
  <article class="reading">
    <h1>{claim}</h1>
    <p>
      <strong>{T.by}:</strong> <a href={localizedPath('experts', locale, pakar.id)}>{pakar.data.name}</a><br />
      <strong>{T.venue}:</strong> {klaim.data.venue}
      {klaim.data.madeAt && <><br /><strong>{T.madeAt}:</strong> {formatDateLocale(klaim.data.madeAt, locale)}</>}
      {klaim.data.reviewedAt && <><br /><strong>{T.reviewed}:</strong> <time datetime={reviewedIso}>{formatDateLocale(klaim.data.reviewedAt, locale)}</time></>}
    </p>
    {klaim.data.topic === 'kesehatan' && <p class="notice" role="note">{T.medical}</p>}

    {docs.length > 0 && (
      <p><strong>{T.doc}:</strong> {docs.map((d, i) => <>{i > 0 && ', '}<a href={arsipPath(d.id, locale)}>{d.data.title}</a></>)}</p>
    )}

    <section aria-labelledby="putusan-h">
      <h2 id="putusan-h">{T.verdict}</h2>
      <p><VerdictBadge verdict={klaim.data.verdict} locale={locale} /> · {T.confidence}: {confidenceLabel(klaim.data.confidence, locale)}</p>
    </section>

    <section aria-labelledby="bukti-h">
      <h2 id="bukti-h">{T.evidence}</h2>
      {evidence.length === 0 ? (
        <p class="muted">{T.noEvidence}</p>
      ) : (
        <ul class="stack">
          {evidence.map((b) => {
            const x = locale === 'en' && b.data.en ? b.data.en : b.data;
            return (
              <li>
                <a href={b.data.images[0].src} target="_blank" rel="noopener noreferrer">{x.title}</a>
                <span class="muted"> · {x.shows}</span>
                <br /><span class="muted">{sourceLineFor({ ...b.data, source: x.source }, locale)}</span>
                {b.data.sourceUrl && <> <a href={b.data.sourceUrl} target="_blank" rel="noopener noreferrer nofollow">{locale === 'id' ? 'sumber' : 'source'}</a></>}
              </li>
            );
          })}
        </ul>
      )}
      <p><a href={routePath('evidence', locale)}>{T.evidence} →</a></p>
    </section>

    <section aria-labelledby="batas-h">
      <h2 id="batas-h">{T.limits}</h2>
      <p>{limits}</p>
    </section>

    {reply && (
      <section aria-labelledby="reply-h">
        <h2 id="reply-h">{T.replyReceived}</h2>
        <p class="muted">{formatDateLocale(reply.receivedAt, locale)} · {T.replyAsReceived}</p>
        <blockquote><p>{replyText}</p></blockquote>
      </section>
    )}
    {klaim.data.replyRequestedAt && !reply && <p class="muted">{T.replyRequested}: {formatDateLocale(klaim.data.replyRequestedAt, locale)}</p>}

    <section aria-labelledby="kutip-h" class="cite">
      <h2 id="kutip-h">{T.cite}</h2>
      <p><code data-cite>{citation}</code></p>
      <p><button type="button" data-copy={citation} data-done={T.copied}>{T.copy}</button> <span role="status" data-copy-status></span></p>
    </section>

    <p class="notice">{T.reply}: {replyStatusLabel(klaim.data.replyStatus, locale)}. <a href={routePath('reply', locale)}>{T.replyLink}</a>.</p>
  </article>
</BaseLayout>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy ?? ''); } catch { return; }
      const s = b.parentElement?.querySelector('[data-copy-status]');
      if (s) s.textContent = b.dataset.done ?? '';
    });
  });
</script>
