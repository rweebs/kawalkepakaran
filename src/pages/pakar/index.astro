---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getKlaim, getPakar } from '../../lib/pakar';
import { localizedPath, routePath, type Locale } from '../../i18n';
const { locale = 'id' } = Astro.props as { locale?: Locale };
const path = localizedPath('experts', locale);
const pakar = (await getPakar()).sort((a, b) => a.data.name.localeCompare(b.data.name));
const klaim = await getKlaim();
const count = (id: string) => klaim.filter((k) => k.data.pakar === id).length;
const T = {
  id: { title: 'Daftar pakar yang diperiksa', h1: 'Pakar', crumb: 'Pakar',
    description: 'Profil para pakar yang klaimnya diperiksa Kawal Kepakaran: kredensial yang diverifikasi, klaim yang dicek, dan tanggapan mereka.',
    lead: 'Setiap pakar punya halaman sendiri: kredensial yang diperiksa, klaim yang diuji, dan tanggapannya.',
    empty: 'Belum ada pakar yang dimuat.', claims: 'klaim diperiksa', method: 'Lihat metode kami' },
  en: { title: 'Experts we have checked', h1: 'Experts', crumb: 'Experts',
    description: "Profiles of the experts whose claims Kawal Kepakaran has checked: verified credentials, claims checked, and the experts' replies.",
    lead: 'Each expert has a page of their own: the credentials checked, the claims tested, and their reply.',
    empty: 'No experts have been listed yet.', claims: 'claims checked', method: 'See our method' },
}[locale];
---
<BaseLayout title={T.title} description={T.description} path={path} locale={locale} breadcrumbs={[{ name: T.crumb, path }]}>
  <article class="reading">
    <h1>{T.h1}</h1>
    <p class="lead">{T.lead}</p>
    {pakar.length === 0 ? (
      <p class="muted">{T.empty}</p>
    ) : (
      <div class="grid">
        {pakar.map((p) => (
          <a class="card card--link" href={localizedPath('experts', locale, p.id)}>
            <h2 class="card-title">{p.data.name}</h2>
            <p>{p.data.field}</p>
            <p class="muted">{count(p.id)} {T.claims}</p>
          </a>
        ))}
      </div>
    )}
    <p><a href={routePath('method', locale)}>{T.method} →</a></p>
  </article>
</BaseLayout>
