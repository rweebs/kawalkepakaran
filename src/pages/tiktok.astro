---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTiktok } from '../lib/content';
import { sortTiktok, thumbSrc, watchUrl, TIKTOK_CAPTION } from '../lib/tiktok';
import { thumbFor, thumbSrcset } from '../lib/bukti';
import { SITE } from '../lib/site';
import { UI } from '../i18n/ui';
import { localizedPath, type Locale } from '../i18n';
const { locale = 'id' } = Astro.props as { locale?: Locale };
const DISCLAIMER = UI[locale].disclaimer;
const videos = sortTiktok(await getTiktok());
const T = {
  id: { title: 'TikTok tentang Abil Sudarman', h1: 'TikTok tentang Abil Sudarman', empty: 'Belum ada video yang dipublikasikan.', video: 'Video', close: 'Tutup', reload: 'Muat ulang', open: 'Buka di TikTok',
    intro: (caption: string) => `Seri video TikTok @rweebs_ dengan keterangan: “${caption}”. Isinya pendapat penulis, bukan putusan. Pemutar TikTok (pihak ketiga) baru dimuat setelah Anda menekan sebuah video; tanpa itu tidak ada permintaan ke TikTok.`,
    note: 'Pemutar TikTok (pihak ketiga) dimuat setelah Anda menekan sebuah video dan dihentikan saat jendela ditutup. TikTok kadang membatasi pemutarnya sementara (“overload-protect triggered”); jika video tidak muncul, muat ulang atau buka langsung di TikTok.',
    description: 'Daftar video TikTok Rahmat Wibowo tentang klaim Abil Sudarman. Putar langsung di halaman; pemutar TikTok baru dimuat setelah Anda menekan video.' },
  en: { title: 'TikTok videos on Abil Sudarman', h1: 'TikTok', empty: 'No videos have been published yet.', video: 'Video', close: 'Close', reload: 'Reload', open: 'Open on TikTok',
    intro: (caption: string) => `The TikTok video series @rweebs_ with the caption (in Indonesian): “${caption}”. The content is the author's opinion, not rulings. The TikTok player (third party) only loads after you press a video; until then no request is made to TikTok.`,
    note: 'The TikTok player (third party) loads after you press a video and is stopped when the window is closed. TikTok sometimes temporarily limits its player (“overload-protect triggered”); if the video does not appear, reload it or open it directly on TikTok.',
    description: "Rahmat Wibowo's TikTok videos about Abil Sudarman's claims (in Indonesian). Play them on the page; the TikTok player only loads after you press a video." },
}[locale];
const path = localizedPath('tiktok', locale);
const DESCRIPTION = T.description;
const ld = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: T.title, url: `${SITE.url}${path}`, inLanguage: locale, description: DESCRIPTION };
const TIKTOK_SIZES = '(min-width: 768px) 220px, 50vw';
---
<BaseLayout title={T.title} description={DESCRIPTION} path={path} locale={locale} jsonLd={ld} breadcrumbs={[{ name: T.h1, path }]}>
  <section class="container pad-block">
    <h1>{T.h1}</h1>
    <p class="muted">{DISCLAIMER}</p>
    <p class="muted">{T.intro(TIKTOK_CAPTION)}</p>
    {videos.length === 0
      ? <p class="muted">{T.empty}</p>
      : <ul class="video-grid tiktok-grid">{videos.map((v) => (
          <li class="card">
            <a class="video-card" href={watchUrl(v.data.tiktokId)} target="_blank" rel="noopener"
               data-tiktok-id={v.data.tiktokId} data-title={v.data.title}>
              <span class="video-thumb">
                <img src={thumbFor(thumbSrc(v.data.tiktokId))} srcset={thumbSrcset(thumbSrc(v.data.tiktokId))} sizes={TIKTOK_SIZES} alt="" width="320" height="569" loading="lazy" decoding="async" />
                <span class="video-play" aria-hidden="true"></span>
              </span>
              <span class="video-title">{v.data.title}</span>
            </a>
          </li>))}</ul>}
  </section>
  <dialog id="video-dialog" class="video-dialog video-dialog--tiktok" aria-labelledby="video-dialog-title">
    <div class="video-dialog__body">
      <div class="video-dialog__bar">
        <h2 id="video-dialog-title">{T.video}</h2>
        <button type="button" class="btn video-close">{T.close}</button>
      </div>
      <div class="video-stage"></div>
      <p class="muted video-note">{T.note}</p>
      <p class="video-fallback">
        <button type="button" class="btn video-reload">{T.reload}</button>
        <a class="btn video-open" href="https://www.tiktok.com/" target="_blank" rel="noopener">{T.open}</a>
      </p>
    </div>
  </dialog>
  <script>import '../scripts/tiktok-modal';</script>
</BaseLayout>
